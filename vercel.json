{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{.vercel/**,.tools/**,.venv/**,dist/**,node_modules/**,src/**,public/**,scripts/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
